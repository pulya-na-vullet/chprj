{
  "name": "neurolegal-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:admin": "vite --config vite.config.admin.ts",
    "build": "tsc --noEmit && vite build",
    "build:admin": "tsc --noEmit && vite build --config vite.config.admin.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview",
    "openapi:generate": "openapi-typescript openapi/rag.json -o src/api/generated/rag.ts && openapi-typescript openapi/agent.json -o src/api/generated/agent.ts",
    "openapi:check": "git diff --exit-code -- openapi src/api/generated",
    "design:preview": "vite-node scripts/render-components.tsx && node scripts/build-design-preview.mjs"
  },
  "dependencies": {
    "@alfalab/core-components": "^50.21.0",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "impeccable": "^3.2.0",
    "jsdom": "^25.0.0",
    "openapi-typescript": "^7.4.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-node": "^3.2.4",
    "vitest": "^3.0.0"
  }
}
