# Local Postgres (docker compose up -d postgres). For Neon/pgbouncer set NEUROLEGAL_DB_STATEMENT_CACHE_SIZE=0.
DATABASE_URL=postgresql://neurolegal:neurolegal@127.0.0.1:5432/neurolegal

# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-...

# Hybrid search relevance floor (article RRF score). 0.0 = off (return top-k always).
# Tune after calibrating on your corpus.
NEUROLEGAL_RAG_MIN_SCORE=0.0

# RAG service base URL (override for staging / docker / split-service deploys).
# Default: http://127.0.0.1:8001 — what `uv run uvicorn neurolegal.rag.api.app:app --port 8001` binds to.
NEUROLEGAL_RAG_BASE_URL=http://127.0.0.1:8001

# Tavily API key — enables the agent's web_search tool. Without it, web_search
# degrades gracefully (returns "unavailable"). web_search/web_fetch are also
# off by default in agent settings (tools.web_search.enabled). Web results are
# context only, never a legal basis.
# NEUROLEGAL_TAVILY_API_KEY=tvly-...

# asyncpg prepared-statement cache. Default (omitted) = 100. Set to 0 when
# connecting through pgbouncer in transaction-pool mode (e.g. Neon `-pooler.`).
# NEUROLEGAL_DB_STATEMENT_CACHE_SIZE=0

# --- Auth / deploy (matter once a service is exposed beyond loopback) ---

# Browser-facing origin of the agent. The Origin/CSRF middleware validates
# mutating requests against it. Default http://127.0.0.1:8000.
# NEUROLEGAL_PUBLIC_BASE_URL=https://neurolegal.example.com

# Secure flag on the neurolegal_session cookie. False for local http dev — MUST be
# true wherever the agent is served over https, or the cookie won't be sent.
# NEUROLEGAL_COOKIE_SECURE=true

# Shared secret gating the agent's internal /admin/users* endpoints (RAG admin
# proxy) and the agent<->documents-hub link. UNSET leaves those operator
# endpoints unauthenticated — set it before exposing the agent externally.
# REQUIRE=true makes the services fail fast at startup if it's not configured.
# NEUROLEGAL_INTERNAL_TOKEN=change-me-shared-secret
# NEUROLEGAL_REQUIRE_INTERNAL_TOKEN=true

# RAG admin console + SPA (corpus management + Пользователи tab). Default True,
# localhost-only, no auth. Set False before exposing the RAG service (:8001).
# NEUROLEGAL_ADMIN_ENABLED=false

# RAG service's endpoint for the agent, used only by the operator users proxy.
# Default http://127.0.0.1:8000.
# NEUROLEGAL_AGENT_BASE_URL=http://127.0.0.1:8000

# S3 — original bytes for the documents hub (neurolegal-documents-api, :8002)
# and corpus .docx for the RAG service (rag/acquisition/corpus_store.py).
# NEUROLEGAL_S3_ENDPOINT=http://127.0.0.1:9000
# NEUROLEGAL_S3_BUCKET=nfs-neurolegal-documents
# NEUROLEGAL_S3_REGION=us-east-1
# NEUROLEGAL_S3_ACCESS_KEY=...
# NEUROLEGAL_S3_SECRET_KEY=...

# Префикс ключей корпусных .docx в бакете (ingest + админская загрузка).
# NEUROLEGAL_CORPUS_S3_PREFIX=corpus/

# Documents hub OCR data dir. rus.traineddata must be provisioned here ahead
# of time (see CLAUDE.md Environment section) — never downloaded at runtime.
# NEUROLEGAL_TESSDATA_PATH=data/tessdata

# Documents hub base URL (override for staging / docker / split-service deploys).
# NEUROLEGAL_DOCUMENTS_BASE_URL=http://127.0.0.1:8002

# Templates service (E20, :8003): endpoint для агента и RAG-прокси админки;
# в docker-деплое — http://templates:8003. Префикс ключей шаблонных .docx в
# общем бакете — только внутри него guard пускает чтение/запись.
# NEUROLEGAL_TEMPLATES_BASE_URL=http://127.0.0.1:8003
# NEUROLEGAL_TEMPLATES_S3_PREFIX=templates/
