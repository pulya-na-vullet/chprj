# Боевое окружение. Копируется на сервер как .env.prod (chmod 600), в git не попадает.

# --- домен и админка ---
NEUROLEGAL_DOMAIN=
NEUROLEGAL_ADMIN_USER=
# Критично: docker compose интерполирует $ в значениях из env_file. Хеш вида
# $2a$14$abcdefghij дойдёт до контейнера caddy как "$2a$14" — остаток съедается
# как несуществующая переменная, и basic-auth на admin.<домен> не поднимется.
# Каждый $ нужно удвоить ($$). Генерировать сразу в экранированном виде:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext '<пароль>' | sed 's/\$/$$/g'
NEUROLEGAL_ADMIN_PASSWORD_HASH=

# --- обязательное для прода ---
# Managed PostgreSQL, приватная сеть: host 192.168.0.5:5432, база default_db,
# пользователь gen_user. Пароль — без спецсимволов либо процентно-кодирован:
# @, :, / внутри пароля ломают разбор URL (@ -> %40 и т.п.).
# DATABASE_URL=postgresql://gen_user:ПАРОЛЬ@192.168.0.5:5432/default_db
DATABASE_URL=
NEUROLEGAL_PUBLIC_BASE_URL=
NEUROLEGAL_COOKIE_SECURE=true
NEUROLEGAL_INTERNAL_TOKEN=
NEUROLEGAL_REQUIRE_INTERNAL_TOKEN=true
NEUROLEGAL_ADMIN_ENABLED=true

# --- адреса сервисов внутри docker-сети ---
NEUROLEGAL_RAG_BASE_URL=http://rag:8001
NEUROLEGAL_DOCUMENTS_BASE_URL=http://documents:8002
NEUROLEGAL_AGENT_BASE_URL=http://agent:8000
NEUROLEGAL_TEMPLATES_BASE_URL=http://templates:8003
NEUROLEGAL_TEMPLATES_S3_PREFIX=templates/

# --- БД ---
# 5-8 на сервис: дефолт 20 x 4 сервиса + overflow упрётся в лимит managed-тарифа.
NEUROLEGAL_DB_POOL_SIZE=8
# 0 при подключении через pooler (pgbouncer в transaction-режиме); для прямого
# подключения к кластеру оставить пустым/дефолт 100. Неизвестно, идёт ли текущий
# managed-кластер через pooler — проверить перед первой выкаткой.
NEUROLEGAL_DB_STATEMENT_CACHE_SIZE=0

# --- внешние сервисы ---
OPENROUTER_API_KEY=
NEUROLEGAL_S3_ENDPOINT=https://s3.twcstorage.ru
NEUROLEGAL_S3_BUCKET=
NEUROLEGAL_S3_REGION=ru-1
NEUROLEGAL_S3_ACCESS_KEY=
NEUROLEGAL_S3_SECRET_KEY=
NEUROLEGAL_CORPUS_S3_PREFIX=corpus/

# --- LLM через заграничную прокси-ноду ---
# NO_PROXY обязателен: botocore тоже читает переменные прокси, и без исключения
# трафик к российскому S3 пойдёт через заграницу. Хост Postgres указывать не
# нужно — asyncpg переменные прокси не читает.
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,agent,rag,documents,s3.twcstorage.ru
